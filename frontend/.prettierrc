{
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": false,

    "tabWidth": 4,
    "useTabs": false,

    "printWidth": 100,

    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,

    "arrowParens": "always",

    "quoteProps": "as-needed",

    "endOfLine": "lf",

    "proseWrap": "preserve",

    "htmlWhitespaceSensitivity": "css",

    "objectWrap": "preserve"
}
